{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:daybook:contracts:v1",
  "title": "Daybook local file contracts; TD revision 1.1",
  "description": "Four entry points; choose the relevant $defs. Semantic validation in TD is mandatory. No network services. Unknown core fields rejected; future changes require a format version. x-graphemeMax / x-maxUtf8Bytes are enforced by application validators, not by JSON Schema alone.",
  "oneOf": [
    {
      "$ref": "#/$defs/EventsExport"
    },
    {
      "$ref": "#/$defs/Manifest"
    },
    {
      "$ref": "#/$defs/BackupSnapshot"
    },
    {
      "$ref": "#/$defs/ContainerHeader"
    }
  ],
  "$defs": {
    "DateSpec": {
      "type": "object",
      "properties": {
        "calendar": {
          "enum": [
            "gregorian",
            "lunar"
          ]
        },
        "year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            {
              "type": "null"
            }
          ]
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "leapMonth": {
          "type": "boolean"
        },
        "allDay": {
          "type": "boolean"
        },
        "localTime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "zoneId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "feb29Policy": {
          "enum": [
            "feb28",
            "mar01"
          ]
        },
        "lunarLeapPolicy": {
          "enum": [
            "normal_fallback",
            "leap_only"
          ]
        },
        "lunarSmallMonthPolicy": {
          "enum": [
            "month_end",
            "skip"
          ]
        },
        "calendarEngineVersion": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "calendar",
        "year",
        "month",
        "day",
        "leapMonth",
        "allDay",
        "localTime",
        "zoneId",
        "feb29Policy",
        "lunarLeapPolicy",
        "lunarSmallMonthPolicy",
        "calendarEngineVersion"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "allDay": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "localTime": {
                "type": "null"
              },
              "zoneId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "localTime": {
                "type": "string"
              },
              "zoneId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "calendar": {
                "const": "gregorian"
              }
            }
          },
          "then": {
            "properties": {
              "leapMonth": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "allDay": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "Recurrence": {
      "type": "object",
      "properties": {
        "frequency": {
          "enum": [
            "none",
            "yearly",
            "monthly",
            "weekly",
            "every_n_days"
          ]
        },
        "intervalDays": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            {
              "type": "null"
            }
          ]
        },
        "until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "frequency",
        "intervalDays",
        "until"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "frequency": {
                "const": "every_n_days"
              }
            }
          },
          "then": {
            "properties": {
              "intervalDays": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "intervalDays": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "GoalDetail": {
      "type": "object",
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "state": {
          "enum": [
            "not_started",
            "in_progress",
            "completed",
            "canceled"
          ]
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "includeInParent": {
          "type": "boolean"
        }
      },
      "required": [
        "startDate",
        "state",
        "completedAt",
        "includeInParent"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "completedAt": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "completedAt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "TextAppearance": {
      "type": "object",
      "properties": {
        "backgroundKind": {
          "enum": [
            "gradient",
            "solid"
          ]
        },
        "presetKey": {
          "type": "string",
          "maxLength": 64
        },
        "solidArgb": {
          "type": "integer"
        },
        "textColorMode": {
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        },
        "fontKey": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "backgroundKind",
        "presetKey",
        "textColorMode",
        "fontKey"
      ],
      "additionalProperties": false
    },
    "FullAppearance": {
      "type": "object",
      "properties": {
        "backgroundKind": {
          "enum": [
            "gradient",
            "solid",
            "photo"
          ]
        },
        "presetKey": {
          "type": "string",
          "maxLength": 64
        },
        "solidArgb": {
          "type": "integer"
        },
        "textColorMode": {
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        },
        "fontKey": {
          "type": "string",
          "maxLength": 64
        },
        "assetRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "focusX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "focusY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dimAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "backgroundKind",
        "presetKey",
        "textColorMode",
        "fontKey"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "backgroundKind": {
                "const": "photo"
              }
            }
          },
          "then": {
            "required": [
              "assetRef",
              "focusX",
              "focusY",
              "dimAmount"
            ],
            "properties": {
              "assetRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      ]
    },
    "TextEvent": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bookRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parentRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "x-graphemeMax": 60,
          "x-maxUtf8Bytes": 4096,
          "minLength": 1
        },
        "kind": {
          "enum": [
            "birthday",
            "memorial",
            "holiday",
            "goal",
            "ordinary"
          ]
        },
        "countMode": {
          "enum": [
            "down",
            "up"
          ]
        },
        "includeStartDay": {
          "type": "boolean"
        },
        "greeting": {
          "type": "string",
          "x-graphemeMax": 2000,
          "x-maxUtf8Bytes": 65536
        },
        "homeVisible": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        },
        "sortRank": {
          "type": "integer"
        },
        "date": {
          "$ref": "#/$defs/DateSpec"
        },
        "repeat": {
          "$ref": "#/$defs/Recurrence"
        },
        "appearance": {
          "$ref": "#/$defs/TextAppearance"
        },
        "goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "x-graphemeMax": 40,
            "x-maxUtf8Bytes": 2048
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "backgroundFallback": {
          "enum": [
            "none",
            "photo_omitted"
          ]
        }
      },
      "required": [
        "ref",
        "bookRef",
        "parentRef",
        "title",
        "kind",
        "countMode",
        "includeStartDay",
        "greeting",
        "homeVisible",
        "pinned",
        "sortRank",
        "date",
        "repeat",
        "appearance",
        "goal",
        "tags",
        "backgroundFallback"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "goal"
              }
            }
          },
          "then": {
            "properties": {
              "goal": {
                "$ref": "#/$defs/GoalDetail"
              },
              "repeat": {
                "properties": {
                  "frequency": {
                    "const": "none"
                  }
                }
              },
              "date": {
                "properties": {
                  "year": {
                    "type": "integer"
                  },
                  "calendar": {
                    "const": "gregorian"
                  },
                  "allDay": {
                    "const": true
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "goal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "birthday"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "properties": {
                  "allDay": {
                    "const": true
                  }
                }
              },
              "repeat": {
                "properties": {
                  "frequency": {
                    "const": "yearly"
                  }
                }
              },
              "countMode": {
                "const": "down"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "date": {
                "properties": {
                  "year": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "birthday"
              }
            }
          }
        }
      ]
    },
    "FullEvent": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bookRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parentRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "x-graphemeMax": 60,
          "x-maxUtf8Bytes": 4096,
          "minLength": 1
        },
        "kind": {
          "enum": [
            "birthday",
            "memorial",
            "holiday",
            "goal",
            "ordinary"
          ]
        },
        "countMode": {
          "enum": [
            "down",
            "up"
          ]
        },
        "includeStartDay": {
          "type": "boolean"
        },
        "greeting": {
          "type": "string",
          "x-graphemeMax": 2000,
          "x-maxUtf8Bytes": 65536
        },
        "homeVisible": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        },
        "sortRank": {
          "type": "integer"
        },
        "date": {
          "$ref": "#/$defs/DateSpec"
        },
        "repeat": {
          "$ref": "#/$defs/Recurrence"
        },
        "appearance": {
          "$ref": "#/$defs/FullAppearance"
        },
        "goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "reminders": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/ReminderRule"
          }
        },
        "tagRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "uniqueItems": true,
          "maxItems": 20
        }
      },
      "required": [
        "ref",
        "bookRef",
        "parentRef",
        "title",
        "kind",
        "countMode",
        "includeStartDay",
        "greeting",
        "homeVisible",
        "pinned",
        "sortRank",
        "date",
        "repeat",
        "appearance",
        "goal",
        "tagRefs",
        "createdAt",
        "updatedAt",
        "version",
        "reminders"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "goal"
              }
            }
          },
          "then": {
            "properties": {
              "goal": {
                "$ref": "#/$defs/GoalDetail"
              },
              "repeat": {
                "properties": {
                  "frequency": {
                    "const": "none"
                  }
                }
              },
              "date": {
                "properties": {
                  "year": {
                    "type": "integer"
                  },
                  "calendar": {
                    "const": "gregorian"
                  },
                  "allDay": {
                    "const": true
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "goal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "birthday"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "properties": {
                  "allDay": {
                    "const": true
                  }
                }
              },
              "repeat": {
                "properties": {
                  "frequency": {
                    "const": "yearly"
                  }
                }
              },
              "countMode": {
                "const": "down"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "date": {
                "properties": {
                  "year": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "birthday"
              }
            }
          }
        }
      ]
    },
    "Book": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "x-graphemeMax": 30,
          "x-maxUtf8Bytes": 2048,
          "minLength": 1
        },
        "builtinKey": {
          "anyOf": [
            {
              "enum": [
                "birthday",
                "memorial",
                "holiday",
                "goal",
                "uncategorized"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "iconKey": {
          "type": "string",
          "maxLength": 64
        },
        "colorArgb": {
          "type": "integer"
        },
        "sortRank": {
          "type": "integer"
        }
      },
      "required": [
        "ref",
        "name",
        "builtinKey",
        "iconKey",
        "colorArgb",
        "sortRank"
      ],
      "additionalProperties": false
    },
    "FullBook": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "x-graphemeMax": 30,
          "x-maxUtf8Bytes": 2048,
          "minLength": 1
        },
        "builtinKey": {
          "anyOf": [
            {
              "enum": [
                "birthday",
                "memorial",
                "holiday",
                "goal",
                "uncategorized"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "iconKey": {
          "type": "string",
          "maxLength": 64
        },
        "colorArgb": {
          "type": "integer"
        },
        "sortRank": {
          "type": "integer"
        },
        "coverAssetRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ref",
        "name",
        "builtinKey",
        "iconKey",
        "colorArgb",
        "sortRank",
        "coverAssetRef",
        "createdAt",
        "updatedAt",
        "version"
      ],
      "additionalProperties": false
    },
    "ReminderRule": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "enabled": {
          "type": "boolean"
        },
        "offsetUnit": {
          "enum": [
            "days",
            "hours",
            "minutes"
          ]
        },
        "offsetValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 525600
        },
        "localTime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "precisionMode": {
          "enum": [
            "normal",
            "precise"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ref",
        "enabled",
        "offsetUnit",
        "offsetValue",
        "localTime",
        "precisionMode",
        "version"
      ],
      "additionalProperties": false
    },
    "EventsExport": {
      "type": "object",
      "properties": {
        "format": {
          "const": "countdown_events"
        },
        "version": {
          "const": 1
        },
        "exportId": {
          "type": "string",
          "format": "uuid"
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time"
        },
        "books": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Book"
          },
          "maxItems": 200
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextEvent"
          },
          "maxItems": 2000
        }
      },
      "required": [
        "format",
        "version",
        "exportId",
        "exportedAt",
        "books",
        "events"
      ],
      "additionalProperties": false
    },
    "ContainerHeader": {
      "type": "object",
      "properties": {
        "containerVersion": {
          "const": 1
        },
        "suite": {
          "enum": [
            "plain",
            "pbkdf2-sha256-aes256gcm"
          ]
        },
        "salt": {
          "anyOf": [
            {
              "type": "string",
              "contentEncoding": "base64"
            },
            {
              "type": "null"
            }
          ]
        },
        "nonce": {
          "anyOf": [
            {
              "type": "string",
              "contentEncoding": "base64"
            },
            {
              "type": "null"
            }
          ]
        },
        "iterations": {
          "anyOf": [
            {
              "const": 600000
            },
            {
              "type": "null"
            }
          ]
        },
        "payloadFormat": {
          "const": "zip"
        }
      },
      "required": [
        "containerVersion",
        "suite",
        "salt",
        "nonce",
        "iterations",
        "payloadFormat"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "suite": {
                "const": "plain"
              }
            }
          },
          "then": {
            "properties": {
              "salt": {
                "type": "null"
              },
              "nonce": {
                "type": "null"
              },
              "iterations": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "salt": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{22}==$"
              },
              "nonce": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{16}$"
              },
              "iterations": {
                "const": 600000
              }
            }
          }
        }
      ]
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "format": {
          "const": "daybook_manifest"
        },
        "version": {
          "const": 1
        },
        "backupId": {
